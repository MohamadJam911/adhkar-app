const extractAyahNumber = (reference: string): string => {
  if (!reference) return '';
  const match = String(reference).match(/(\d+|[٠-٩]+)/g);
  if (match && match.length > 0) {
    return formatArabicNumbers(match[match.length - 1]);
  }
  return '';
};

