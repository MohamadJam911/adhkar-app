{
  "expo": {
    "name": "مسرى المسلم",
    "slug": "adhkar-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mohamad.masra",
      "appleTeamId": "24G8Q7F42U",
      "buildNumber": "1",
      "userInterfaceStyle": "automatic",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نستخدم موقعك الجغرافي فقط لحساب مواقيت الصلاة الدقيقة لمدينتك وتحديد اتجاه القبلة الصحيح. لا يتم تخزين موقعك أو مشاركته مع أي جهة خارجية.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.mohamad.masra"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1",
              "1C8F.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12241F"
      },
      "package": "com.mohamad.masra",
      "versionCode": 1,
      "userInterfaceStyle": "automatic",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#12241F"
        }
      ],
      "expo-sharing",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/widget/WidgetAmiriBold.ttf",
            "./assets/fonts/widget/WidgetCairoBold.ttf",
            "./assets/fonts/widget/WidgetCairoSemiBold.ttf",
            "./assets/fonts/widget/WidgetCinzelBold.ttf"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "نستخدم موقعك الجغرافي فقط لحساب مواقيت الصلاة الدقيقة لمدينتك وتحديد اتجاه القبلة الصحيح. لا يتم تخزين موقعك أو مشاركته مع أي جهة خارجية.",
          "locationWhenInUsePermission": "نستخدم موقعك الجغرافي فقط لحساب مواقيت الصلاة الدقيقة لمدينتك وتحديد اتجاه القبلة الصحيح. لا يتم تخزين موقعك أو مشاركته مع أي جهة خارجية."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D4A373"
        }
      ],
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PrayerWidget",
              "label": "الصلاة القادمة",
              "description": "يعرض اسم ووقت الصلاة القادمة (أو وقت الإقامة الحالي) والوقت المتبقي عليها مباشرة من الشاشة الرئيسية، بحجم مصغّر قابل للتكبير حسب رغبتك",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "MasraPalaceWidget",
              "label": "مسرى المسلم — القصر الزمردي",
              "description": "تصميم فاخر بالأخضر الزمردي والذهبي: الصلاة القادمة ومواقيت اليوم كاملة من التقويم الدهري، مع التاريخ الهجري ومدينتك",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "owner": "mohamad_911",
    "updates": {
      "url": "https://u.expo.dev/618035a7-c436-495a-8ea2-ddf5caac83c1",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.mohamad.masra.widget",
                  "targetName": "MasraWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.mohamad.masra"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "618035a7-c436-495a-8ea2-ddf5caac83c1"
      }
    }
  }
}
